<Slide style={{ width: 1280, height: 720, background: '#0A0D0C', padding: '76px 72px 44px 72px', flexDirection: 'column' }}>
    <Box style={{ flexDirection: 'row', gap: 48, height: 322 }}>
        <Box style={{ width: 668, flexDirection: 'column' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
                <Box style={{ width: 26, height: 2, background: '#3DDC84' }} />
                <Text style={{ fontSize: 13, color: '#3DDC84', letterSpacing: 3 }}>如果今天只记住一句话</Text>
            </Box>
            <Text style={{ fontSize: 50, fontWeight: 'bold', color: '#E9F1EC', lineHeight: 1.3, marginTop: 22, letterSpacing: 1 }}>能演完的 60 分，</Text>
            <Text style={{ fontSize: 50, fontWeight: 'bold', color: '#3DDC84', lineHeight: 1.3, letterSpacing: 1 }}>胜过没演完的 100 分。</Text>
            <Text style={{ fontSize: 16.5, color: '#E9F1EC', opacity: 0.55, lineHeight: 1.8, marginTop: 20, width: 640 }}>
                TRAE 让你写得更快，但决定成败的从来不是写得多快——是你能不能在台上把那 60 秒讲完。
            </Text>
        </Box>

        <Box style={{ width: 380, flexDirection: 'column', gap: 16, paddingLeft: 28, borderLeft: '1px solid rgba(233,241,236,0.10)' }}>
            <Text style={{ fontSize: 12.5, color: '#E9F1EC', opacity: 0.4, letterSpacing: 2 }}>回顾 · 三条铁律</Text>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 13, color: '#3DDC84' }}>01</Text>
                <Text style={{ fontSize: 16, color: '#E9F1EC', lineHeight: 1.5 }}>演示动线先于代码</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 13, color: '#3DDC84' }}>02</Text>
                <Text style={{ fontSize: 16, color: '#E9F1EC', lineHeight: 1.5 }}>并行之前先冻结接口</Text>
            </Box>
            <Box style={{ flexDirection: 'column', gap: 4 }}>
                <Text style={{ fontSize: 13, color: '#3DDC84' }}>03</Text>
                <Text style={{ fontSize: 16, color: '#E9F1EC', lineHeight: 1.5 }}>稳定性优先于完整性</Text>
            </Box>
            <Text style={{ fontSize: 12.5, color: '#E9F1EC', opacity: 0.4, lineHeight: 1.6, marginTop: 'auto' }}>今天讲的所有东西，都是这三条的注脚。</Text>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 40, marginTop: 6, paddingTop: 22, paddingBottom: 22, borderTop: '1px solid rgba(233,241,236,0.08)', borderBottom: '1px solid rgba(233,241,236,0.08)' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#3DDC84' }}>3</Text>
            <Text style={{ fontSize: 13, color: '#E9F1EC', opacity: 0.5 }}>条并行线，文件互斥</Text>
        </Box>
        <Box style={{ width: 1, height: 24, background: 'rgba(233,241,236,0.12)' }} />
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#3DDC84' }}>1331</Text>
            <Text style={{ fontSize: 13, color: '#E9F1EC', opacity: 0.5 }}>组参数预生成，零后端可演</Text>
        </Box>
        <Box style={{ width: 1, height: 24, background: 'rgba(233,241,236,0.12)' }} />
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#3DDC84' }}>2.6×</Text>
            <Text style={{ fontSize: 13, color: '#E9F1EC', opacity: 0.5 }}>三个均衡任务的实测提速</Text>
        </Box>
        <Box style={{ width: 1, height: 24, background: 'rgba(233,241,236,0.12)' }} />
        <Box style={{ flexDirection: 'row', alignItems: 'baseline', gap: 8 }}>
            <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#3DDC84' }}>90</Text>
            <Text style={{ fontSize: 13, color: '#E9F1EC', opacity: 0.5 }}>分钟，从关键词到上台</Text>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 40, marginTop: 'auto' }}>
        <Box style={{ width: 340, flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 13, color: '#3DDC84', letterSpacing: 2 }}>明天就能做</Text>
            <Text style={{ fontSize: 14.5, color: '#E9F1EC', opacity: 0.72, lineHeight: 1.7 }}>随便抽三个关键词，写一份 60 秒脚本——20 分钟，不写一行代码。</Text>
        </Box>
        <Box style={{ width: 340, flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 13, color: '#3DDC84', letterSpacing: 2 }}>下次并行前</Text>
            <Text style={{ fontSize: 14.5, color: '#E9F1EC', opacity: 0.72, lineHeight: 1.7 }}>先花 10 分钟写契约.md：字段名、签名、路径、文件所有权，然后冻结。</Text>
        </Box>
        <Box style={{ width: 340, flexDirection: 'column', gap: 8 }}>
            <Text style={{ fontSize: 13, color: '#3DDC84', letterSpacing: 2 }}>交付前</Text>
            <Text style={{ fontSize: 14.5, color: '#E9F1EC', opacity: 0.72, lineHeight: 1.7 }}>把兜底当成需求项：超时 mock、预生成表、录屏，三样至少有两样。</Text>
        </Box>
    </Box>

    <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'flex-end', marginTop: 24 }}>
        <Text style={{ fontSize: 12, color: '#E9F1EC', opacity: 0.38 }}>TRAE 高效开发实战 · 1024 济宁 · 2026.10.24</Text>
        <Text style={{ fontSize: 12, color: '#E9F1EC', opacity: 0.38 }}>11 / 11</Text>
